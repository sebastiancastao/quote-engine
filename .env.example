# Persistent local SQLite file. Use a mounted persistent disk in a hosted setup.
QUOTE_DB_PATH=.data/quotes.sqlite

# The Xcelerator base URL, including any application subdirectory, without /Axis.
# Verify the tenant's Axis/Swagger schema and caller permissions before live use.
AXIS_BASE_URL=
AXIS_USERNAME=
AXIS_PASSWORD=

# counts = OrderPackages; items = OrderPackageItems (for accounts that scan pieces).
AXIS_PACKAGE_MODE=counts
